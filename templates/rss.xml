{% set language = languages.en %}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
<title>{{ title ~ " on " ~ language.title if title else language.title }}</title>
<link>{{ absolute(url) }}</link>
<description>Recent content {% if title %}in {{ title }} {% endif %}on {{ language.title }}</description>
<language>en</language>
<copyright>{{ language.copyright }}</copyright>
{% if latest %}<lastBuildDate>{{ rfc822(latest) }}</lastBuildDate>{% endif %}

<atom:link href="{{ absolute(url) }}index.xml" rel="self" type="application/rss+xml"/>
{% for p in items %}
<item>
  <title>{{ p.title }}</title>
  <link>{{ absolute(p.url) }}</link>
  <pubDate>{{ rfc822(p.date) }}</pubDate>
  <guid>{{ absolute(p.url) }}</guid>
  <description>{{ strip_tags(p.summary or "") }}</description>
</item>
{% endfor %}
</channel>
</rss>
